{
  "name": "lycan",
  "productName": "LYCAN",
  "version": "0.1.0",
  "description": "LYCAN — The Ultimate Werewolf Simulator. Open-world supernatural action prototype.",
  "author": "LYCAN Team",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "serve": "node scripts/build.mjs && npx --yes http-server app -p 8080 -c-1",
    "start": "node scripts/build.mjs && electron .",
    "smoke": "node scripts/build.mjs && node scripts/smoke-test.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux",
    "dist:win": "node scripts/build.mjs && electron-builder --win",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac",
    "dist:all": "node scripts/build.mjs && electron-builder --linux AppImage tar.gz --win zip --mac zip"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "three": "0.169.0"
  },
  "build": {
    "appId": "com.lycangame.lycan",
    "productName": "LYCAN",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "app/**/*", "package.json"],
    "asar": true,
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["zip", "nsis"],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": {
      "target": ["zip", "dmg"],
      "category": "public.app-category.action-games",
      "icon": "build/icon.png",
      "identity": null
    }
  }
}
